# NoboGhat Mobile App Environment Configuration
# Default to production Spring Boot backend on Render
EXPO_PUBLIC_API_URL=https://noboghat-bangladesh.onrender.com/api

# For local testing, uncomment and set your LAN IP or emulator host:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api      # Android Emulator
# EXPO_PUBLIC_API_URL=http://localhost:8080/api     # iOS Simulator
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api # Physical device on Wi-Fi
