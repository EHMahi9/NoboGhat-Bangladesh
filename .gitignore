# ==============================================================================
# NoboGhat - Modern Inland Water Transport (Git Ignore Rules)
# ==============================================================================

# Node dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build/
/dist/
/.dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage/

# Environment Variables & Secrets (Keep private, never commit actual credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
backend/.env
backend/.env.local
backend/.env*.local

# Allow committing environment templates
!.env.example
!backend/.env.example

# Java / Spring Boot Backend
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/src/main/**/target/
!backend/src/test/**/target/
backend/uploads/

# User Uploaded Media & Large Avatars (Keep folder via .gitkeep)
/public/uploads/avatar-*
/public/uploads/*.png
/public/uploads/*.jpg
/public/uploads/*.jpeg
/public/uploads/*.gif
/public/uploads/*.webp
!/public/uploads/.gitkeep

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.user

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Scratch scripts & temporary backup files
*.bak
scratch/
.system_generated/
