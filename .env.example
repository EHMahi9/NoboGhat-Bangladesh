# ==============================================================================
# NoboGhat - Modern Inland Water Transport (নৌঘাট বাংলাদেশ)
# Next.js Frontend & Full-Stack API Gateway Configuration
# ==============================================================================

# Client API Base URL (defaults to Next.js internal API proxy /api)
NEXT_PUBLIC_API_URL=/api

# Upstream Spring Boot Backend Service URL
# Production: https://noboghat-bangladesh.onrender.com
# Local development with Spring Boot: http://localhost:8080
BACKEND_API_URL=https://noboghat-bangladesh.onrender.com

# Runtime Environment
NODE_ENV=development
